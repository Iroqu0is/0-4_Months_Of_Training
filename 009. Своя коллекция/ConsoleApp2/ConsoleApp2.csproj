<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>ConsoleApp2.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ConsoleApp1">
      <HintPath>..\ConsoleApp1\bin\Debug\net8.0\ConsoleApp1.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="ConsoleApp1" />
    <Using Include="System.Collections" />
    <Using Include="System.Console">
      <Static>True</Static>
    </Using>
    <Using Include="System.Diagnostics" />
    <Using Include="System.Math">
      <Static>True</Static>
    </Using>
    <Using Include="System.Numerics" />
    <Using Include="System.Reflection" />
    <Using Include="System.Text" />
  </ItemGroup>

</Project>
